<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="accessibility_service_label">FOKUS App-Blockierung</string>
    <string name="accessibility_service_description">FOKUS nutzt diesen Bedienungshilfen-Dienst für genau einen Zweck: zu erkennen, wenn eine von dir blockierte App während einer von dir gestarteten Fokus-Sitzung geöffnet wird, um einen sanften Erinnerungsbildschirm anzuzeigen. FOKUS liest keine Bildschirminhalte, sammelt keine Browserdaten und sendet niemals Verhaltensdaten von deinem Gerät.</string>

    <!-- F-04 Sitzungs-Benachrichtigung (nativ; PM-Review mit F-20). -->
    <string name="session_notification_channel_name">Fokus-Sitzung</string>
    <string name="session_notification_channel_description">Zeigt deine laufende Fokus-Sitzung und die verbleibende Zeit.</string>
    <string name="session_notification_title_fallback">Fokus-Sitzung</string>
    <string name="session_notification_text">Noch %1$d Min.</string>

    <!-- F-05 Intercept-Screen (nativ; PM-Review mit F-20). -->
    <string name="intercept_headline">%1$s kann warten.</string>
    <string name="intercept_icon_description">%1$s Symbol</string>
    <string name="intercept_anchor">Dein Vorhaben: %1$s</string>
    <string name="intercept_cta_return">Zurück zum Fokus</string>
    <string name="intercept_cta_stuck">Ich hänge fest</string>
    <string name="intercept_cta_emergency">Notausgang</string>
    <string name="intercept_hint_repeated">Schon ein paar Anläufe — 30 Sekunden durchatmen könnte helfen.</string>
    <plurals name="intercept_time_remaining">
        <item quantity="one">Noch %1$d Minute in deiner Session</item>
        <item quantity="other">Noch %1$d Minuten in deiner Session</item>
    </plurals>
    <!-- Schedule reminder + auto-start (F-13). -->
    <string name="schedule_channel_name">Geplante Sessions</string>
    <string name="schedule_reminder_title">%1$s startet in 5 Minuten</string>
    <string name="schedule_reminder_body">Deine geplante Fokus-Session beginnt gleich.</string>
    <string name="schedule_reminder_skip">Diesmal überspringen</string>
</resources>
