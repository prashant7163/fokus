<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Privacy hard rule: NO network permission in the main manifest.
         INTERNET lives only in debug/profile manifests (Flutter tooling). -->

    <!-- Usage access (supplementary detection; granted via settings screen). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lets us open the direct battery-exemption request dialog. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- F-04: session resilience — countdown notification + foreground
         service + re-arm after reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="FOKUS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Theme to apply while the Flutter UI initializes. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- F-05: intercept CTAs deep-link into the Flutter shell
                 (fokus://recovery, fokus://exit) via Flutter's own
                 deep-linking — go_router registers the routes (F-06+). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fokus" />
            </intent-filter>
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
        </activity>

        <!-- F-05: blocked-app intercept. Native (< 200 ms cold render), own
             task, never in recents. -->
        <activity
            android:name=".blocking.InterceptActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity="ch.hoffely.fokus.intercept"
            android:theme="@style/InterceptTheme" />
        <!-- F-03: foreground-app detection. Disclosure flow (F-10) precedes
             enabling; config keeps window-content access off. -->
        <service
            android:name=".blocking.FokusAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- F-04: session resilience — persistent countdown notification,
             START_STICKY re-hydration after process kill. specialUse: no
             standard FGS type covers "keep a user-started app-blocking
             session alive"; subtype declared for Play review. -->
        <service
            android:name=".blocking.SessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started focus session and its countdown notification running so chosen app-blocking survives process death. No standard foregroundServiceType covers app-blocking focus timers." />
        </service>

        <!-- F-04: re-arm an active session after reboot. BOOT_COMPLETED is
             a protected broadcast — only the system can send it. -->
        <receiver
            android:name=".blocking.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <!-- Required for text processing (Flutter engine default). -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility for the app picker (getInstalledApps): FOKUS
             must list launchable apps the user can choose to block. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
